rules_version = '2';
service cloud.firestore { match /databases/{db}/documents {
  function signed(){ return request.auth != null; }
  function role(){ return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
  function proj(p){ return get(/databases/$(db)/documents/projects/$(p)).data; }
  match /users/{u} {
    allow read: if signed() && (request.auth.uid == u || role() == 'admin');
    allow create: if signed() && request.auth.uid == u && request.resource.data.role in ['client','freelancer'];
    allow update: if signed() && request.auth.uid == u && request.resource.data.role == resource.data.role;
  }
  match /freelancers/{f} {
    allow read: if true;
    allow create: if signed() && request.auth.uid == f && role() == 'freelancer' && request.resource.data.verified == false;
    allow update: if (signed() && request.auth.uid == f && request.resource.data.verified == resource.data.verified) || (signed() && role() == 'admin');
  }
  match /businesses/{b} {
    allow read: if true;
    allow create: if signed() && request.auth.uid == b && role() == 'client' && request.resource.data.verified == false;
    allow update: if (signed() && request.auth.uid == b && request.resource.data.verified == resource.data.verified) || (signed() && role() == 'admin');
  }
  match /projects/{p} {
    allow read: if true;
    allow create: if signed() && role() == 'client' && request.resource.data.owner == request.auth.uid && request.resource.data.status == 'open';
    allow update: if signed() && resource.data.owner == request.auth.uid;
    allow delete: if signed() && (resource.data.owner == request.auth.uid || role() == 'admin');
    match /messages/{m} {
      allow read: if signed() && (proj(p).owner == request.auth.uid || proj(p).hired == request.auth.uid);
      allow create: if signed() && request.resource.data.from == request.auth.uid && (proj(p).owner == request.auth.uid || proj(p).hired == request.auth.uid);
    }
  }
  match /proposals/{x} {
    allow create: if signed() && role() == 'freelancer' && request.resource.data.freelancer == request.auth.uid && request.resource.data.status == 'Pending' && proj(request.resource.data.project).status == 'open';
    allow read: if signed() && (resource.data.freelancer == request.auth.uid || resource.data.client == request.auth.uid || role() == 'admin');
    allow update: if signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
      ((resource.data.client == request.auth.uid && request.resource.data.status in ['Accepted','Declined']) || (resource.data.freelancer == request.auth.uid && request.resource.data.status == 'Withdrawn'));
  }
  match /reviews/{r} {
    allow read: if true;
    allow create: if signed() && r == request.resource.data.get('projectId', r) && proj(r).owner == request.auth.uid && proj(r).status == 'completed' && request.resource.data.client == request.auth.uid && request.resource.data.rating in [1,2,3,4,5];
  }
}}
